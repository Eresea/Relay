{
  "name": "umbra-gallery",
  "private": true,
  "description": "Every Umbra component in one page, plus the checks that run against it.",
  "scripts": {
    "postinstall": "node -e \"require('fs').rmSync('../node_modules',{recursive:true,force:true});require('fs').symlinkSync(require('path').resolve('node_modules'),'../node_modules','junction')\"",
    "start": "ng serve",
    "build": "ng build",
    "check": "ng build && node check.mjs"
  },
  "dependencies": {
    "@angular/cdk": "^22.0.4",
    "@angular/common": "22.0.6",
    "@angular/compiler": "22.0.6",
    "@angular/core": "22.0.6",
    "@angular/forms": "22.0.6",
    "@angular/platform-browser": "22.0.6",
    "@tanstack/angular-table": "^9.0.1",
    "@tanstack/angular-virtual": "^6.0.2",
    "@tanstack/charts": "0.14.0",
    "date-fns": "^4.4.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.6",
    "@angular/cli": "^22.0.6",
    "@angular/compiler-cli": "22.0.6",
    "axe-core": "^4.11.0",
    "playwright-core": "^1.56.0",
    "sass": "^1.93.0",
    "typescript": "~6.0.3"
  }
}
