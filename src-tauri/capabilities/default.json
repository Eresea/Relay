{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities granted to every Relay window. Kept deliberately narrow: the core exposes its own commands rather than handing the webview broad plugin access.",
  "windows": ["main", "palette", "hud"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "codex://threads/*" }]
    },
    "store:default",
    "log:default",
    "autostart:default"
  ]
}
